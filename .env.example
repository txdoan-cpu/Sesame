# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (cloud project, region: Canada)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider: "claude" (default) or "gemini" (temporary fallback, synthetic data only)
LLM_PROVIDER=claude
# Server only.
ANTHROPIC_API_KEY=
# Verify current model names at https://docs.claude.com before changing.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server only, optional.
GEMINI_API_KEY=

# Email (Round 6)
RESEND_API_KEY=

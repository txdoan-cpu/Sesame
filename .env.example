# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (cloud project, region: Canada)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider: "claude" (default) or "gemini" (temporary fallback, synthetic data only)
LLM_PROVIDER=claude
# Server only.
ANTHROPIC_API_KEY=
# Verify current model names at https://docs.claude.com before changing.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server only, optional (free key at https://aistudio.google.com). Synthetic data only.
GEMINI_API_KEY=
# Optional. Defaults: gemini-flash-lite-latest, backup gemini-3.1-flash-lite (free-tier friendly).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Email (Round 6)
RESEND_API_KEY=

# Demo accounts (npm run demo:reset). Optional; a random password is printed if empty.
DEMO_PASSWORD=
# Tester account for the outcome-board check (npm run demo:testers). Use a different password from DEMO_PASSWORD.
TESTER_PASSWORD=

# Scheduled checks (/api/cron/engagement). Any long random string; the scheduler sends it as a Bearer token.
# vercel.json runs it daily at 22:00 St. John's time: 01:30 UTC (NST, winter) and 00:30 UTC (NDT, summer).
# Each step is idempotent, so the extra run an hour off is harmless. Vercel Hobby may start a job anytime within that hour.
CRON_SECRET=
# Optional sender for parent emails (Resend). Email is skipped when RESEND_API_KEY is empty.
RESEND_FROM=
